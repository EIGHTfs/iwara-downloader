# ============================================================
# iwara-downloader —— 品牌配置示例
#
# 用法：把这几行写进项目根 .env（或临时 export 成环境变量）后按需改；
# 服务端启动时由 server/config/brand.js 的 readBrand() 读取，start.sh 不做 source。
#
# 取值优先级（高 → 低）：
#   1. 进程环境变量 BRAND_*（部署时 export 即可，不改文件）
#   2. 项目根 .env 的 BRAND_*（本示例的内容）
#   3. assemble.json 的 brand 段
#   4. 内置默认值：title=Downloader / logo=favicon.png / icon=favicon.png
#
# 任一层留空（如 BRAND_LOGO=）等于没配，会继续往下一级取；四个键最终都有值，
# 页面不会再出现 @brand:xxx@ 占位符。
# ============================================================

# 浏览器标签页标题（<title>）
BRAND_TITLE=iwara-downloader

# 顶栏/页面头部 logo 文件名，相对 server/public/
BRAND_LOGO=iwara-logo.png

# 浏览器标签页图标（favicon），相对 server/public/
BRAND_ICON=favicon.png

# 顶栏标题文字，允许内联 HTML（换行用 <br>，不会被转义）
# 留空或不写时回退 BRAND_TITLE
BRAND_DISPLAY_TITLE=Iwara<br>Video<br>Downloader
