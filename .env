# iwara-downloader —— 品牌配置（每行 KEY=VALUE，# 为注释）
# 谁读：server/config/brand.js 的 readBrand()（服务端启动时读；start.sh 不做 source，改完重启即可）
# 优先级：进程环境变量 BRAND_* > 本文件 > assemble.json 的 brand 段 > 内置默认
# 任一键留空（如 BRAND_LOGO=）等于没配，继续往下一级取；四个标准键最终都有值，
# 页面不会残留 @brand:xxx@ 占位符。

# 浏览器标签页标题（<title>）
BRAND_TITLE=iwara-downloader
# 顶栏/页面头部 logo 文件名，相对 server/public/
BRAND_LOGO=iwara-logo.png
# 浏览器标签页图标（favicon），相对 server/public/
BRAND_ICON=favicon.png
# 顶栏标题文字，允许内联 HTML（<br> 换行不转义）；留空或不写时回退 BRAND_TITLE
BRAND_DISPLAY_TITLE=Iwara<br>Video<br>Downloader
